@{
    ViewData["Title"] = "Admin Panel";
}

<div class="container mt-4">
    <h1>Admin Panel</h1>

    <!-- Statistici -->
    <div class="row mt-4">
        <div class="col-md-3">
            <div class="card">
                <div class="card-body text-center">
                    <h5 class="card-title">Utilizatori</h5>
                    <p class="h3 text-primary">@ViewBag.TotalUsers</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card">
                <div class="card-body text-center">
                    <h5 class="card-title">Admini</h5>
                    <p class="h3 text-success">@ViewBag.TotalAdmins</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card">
                <div class="card-body text-center">
                    <h5 class="card-title">Parole</h5>
                    <p class="h3 text-warning">@ViewBag.TotalPasswords</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card">
                <div class="card-body text-center">
                    <h5 class="card-title">Note</h5>
                    <p class="h3 text-info">@ViewBag.TotalNotes</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Secțiunea Utilizatori -->
    <div class="mt-5">
        <h2>Utilizatori</h2>

        <!-- Tabs pentru Utilizatori Active / Șterși -->
        <ul class="nav nav-tabs" id="usersTab" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="activeUsers-tab" data-bs-toggle="tab" data-bs-target="#activeUsers" type="button" role="tab" aria-controls="activeUsers" aria-selected="true">
                    ✓ Utilizatori Activi
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="deletedUsers-tab" data-bs-toggle="tab" data-bs-target="#deletedUsers" type="button" role="tab" aria-controls="deletedUsers" aria-selected="false">
                    🗑️ Utilizatori Șterși
                </button>
            </li>
        </ul>

        <!-- Tab Content -->
        <div class="tab-content" id="usersTabContent">
            <!-- Utilizatori Activi -->
            <div class="tab-pane fade show active" id="activeUsers" role="tabpanel" aria-labelledby="activeUsers-tab">
                <table id="usersTable" class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Email <button type="button" class="btn btn-link btn-sm p-0 ms-1 text-white text-decoration-none" onclick="sortUsers('email')" title="Sortează">⇅</button></th>
                            <th>Admin <button type="button" class="btn btn-link btn-sm p-0 ms-1 text-white text-decoration-none" onclick="sortUsers('isAdmin')" title="Sortează">⇅</button></th>
                            <th>Activ <button type="button" class="btn btn-link btn-sm p-0 ms-1 text-white text-decoration-none" onclick="sortUsers('isActive')" title="Sortează">⇅</button></th>
                            <th>Creat la <button type="button" class="btn btn-link btn-sm p-0 ms-1 text-white text-decoration-none" onclick="sortUsers('createdUtc')" title="Sortează">⇅</button></th>
                            <th>Acțiuni</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>

            <!-- Utilizatori Șterși -->
            <div class="tab-pane fade" id="deletedUsers" role="tabpanel" aria-labelledby="deletedUsers-tab">
                <table id="deletedUsersTable" class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Email <button type="button" class="btn btn-link btn-sm p-0 ms-1 text-white text-decoration-none" onclick="sortDeletedUsers('email')" title="Sortează">⇅</button></th>
                            <th>Șters la <button type="button" class="btn btn-link btn-sm p-0 ms-1 text-white text-decoration-none" onclick="sortDeletedUsers('deletedUtc')" title="Sortează">⇅</button></th>
                            <th>Șters de <button type="button" class="btn btn-link btn-sm p-0 ms-1 text-white text-decoration-none" onclick="sortDeletedUsers('deletedBy')" title="Sortează">⇅</button></th>
                            <th>Acțiuni</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal pentru resetare parolă și trimitere email -->
<div id="resetPasswordModal" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">🔐 Resetare Parolă</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="resetContent"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Închide</button>
                <button type="button" class="btn btn-primary" id="btnSendEmail">
                    ✉️ Trimite Email
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Confirmare Delete User -->
<div id="deleteUserModal" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content border-danger">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">⚠️ Confirmare Ștergere Utilizator</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Ești sigur că vrei să ștergi utilizatorul?</p>
                <p><strong id="deleteUserEmail"></strong></p>
                <p class="text-muted small">
                    ℹ️ Datele utilizatorului nu vor fi șterse permanent. Poți readmite utilizatorul mai târziu din secțiunea "Utilizatori Șterși".
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Anulează</button>
                <button type="button" class="btn btn-danger" id="btnConfirmDelete">
                    🗑️ Șterge Utilizator
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Confirmare Restore User -->
<div id="restoreUserModal" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content border-success">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title">🔄 Confirmare Restaurare Utilizator</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Ești sigur că vrei să readmiti utilizatorul?</p>
                <p><strong id="restoreUserEmail"></strong></p>
                <p class="text-muted small">
                    ℹ️ Utilizatorul va putea să se autentifice din nou și va accesa toate datele sale.
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Anulează</button>
                <button type="button" class="btn btn-success" id="btnConfirmRestore">
                    🔄 Restaurează Utilizator
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    // Variabile globale pentru modal
    let currentResetData = null;
    let currentUserId = null;
    let usersData = [];
    let usersSort = { key: null, dir: 'asc' };
    let deletedUsersData = [];
    let deletedUsersSort = { key: null, dir: 'asc' };
    document.addEventListener('DOMContentLoaded', function () {
        loadUsers();

        // Încarcă utilizatori șterși când se deschide tab-ul
        document.getElementById('deletedUsers-tab').addEventListener('shown.bs.tab', function() {
            loadDeletedUsers();
        });
    });

    function loadUsers() {
        fetch('/Admin/GetUsers')
            .then(response => response.json())
            .then(data => {
                usersData = data;
                renderUsers();
            })
            .catch(error => console.error('Eroare:', error));
    }

    function renderUsers() {
        const tbody = document.querySelector('#usersTable tbody');
        tbody.innerHTML = '';

        sortUsersData(usersData).forEach(user => {
            const row = document.createElement('tr');
                    row.innerHTML = `
                        <td>${user.id}</td>
                        <td>${user.email}</td>
                        <td>
                            <button class="btn btn-sm ${user.isAdmin ? 'btn-success' : 'btn-secondary'}"
                                    onclick="toggleAdmin(${user.id}, event)"
                                    title="Apasă pentru a schimba statusul admin">
                                ${user.isAdmin ? '✓ Admin' : 'User'}
                            </button>
                        </td>
                        <td>
                            <button class="btn btn-sm ${user.isActive ? 'btn-success' : 'btn-danger'}"
                                    onclick="toggleActive(${user.id}, event)"
                                    title="Apasă pentru a schimba statusul">
                                ${user.isActive ? '✓ Activ' : '✗ Inactiv'}
                            </button>
                        </td>
                        <td>${new Date(user.createdUtc).toLocaleString('ro-RO')}</td>
                        <td>
                            <div class="btn-group btn-group-sm" role="group">
                                <button class="btn btn-outline-info" 
                                        onclick="showUserDetails(${user.id}, event)"
                                        title="Vezi detalii utilizator">
                                    📋 Detalii
                                </button>
                                <button class="btn btn-outline-warning" 
                                        onclick="resetUserPassword(${user.id}, '${user.email}', event)"
                                        title="Resetează parola utilizatorului">
                                    🔑 Reset Pass
                                </button>
                                <button class="btn btn-outline-danger" 
                                        onclick="deleteUser(${user.id}, '${user.email}', event)"
                                        title="Șterge utilizatorul (soft delete)">
                                    🗑️ Delete
                                </button>
                            </div>
                        </td>
                    `;
                    tbody.appendChild(row);
        });
    }

    function sortUsers(key) {
        usersSort = {
            key: key,
            dir: usersSort.key === key && usersSort.dir === 'asc' ? 'desc' : 'asc'
        };
        renderUsers();
    }

    function sortUsersData(users) {
        if (!usersSort.key) return users;

        const factor = usersSort.dir === 'asc' ? 1 : -1;
        return [...users].sort((a, b) => {
            const va = getUserSortValue(a, usersSort.key);
            const vb = getUserSortValue(b, usersSort.key);
            const cmp = typeof va === 'number' ? va - vb : va.localeCompare(vb, 'ro');
            return cmp * factor;
        });
    }

    function getUserSortValue(user, key) {
        if (key === 'isAdmin') return user.isAdmin ? 'Admin' : 'User';
        if (key === 'isActive') return user.isActive ? 'Activ' : 'Inactiv';
        if (key === 'email') return user.email;
        return new Date(user.createdUtc).getTime();
    }

    function toggleAdmin(userId, event) {
        event.preventDefault();

        if (!confirm('Sigur schimbi statusul admin?')) return;

        fetch(`/Admin/ToggleAdmin?userId=${userId}`, { method: 'POST' })
            .then(response => {
                if (response.status === 403) {
                    alert('Nu ai permisiuni!');
                    return null;
                }
                return response.json();
            })
            .then(data => {
                if (data && data.success) {
                    loadUsers();
                    alert('Status admin actualizat cu succes!');
                } else if (data) {
                    alert('Eroare: ' + (data.message || 'Operație eșuată'));
                }
            })
            .catch(error => {
                console.error('Eroare:', error);
                alert('Eroare la actualizare!');
            });
    }

    function toggleActive(userId, event) {
        event.preventDefault();

        if (!confirm('Sigur schimbi statusul activ?')) return;

        fetch(`/Admin/ToggleActive?userId=${userId}`, { method: 'POST' })
            .then(response => {
                if (response.status === 403) {
                    alert('Nu ai permisiuni!');
                    return null;
                }
                return response.json();
            })
            .then(data => {
                if (data && data.success) {
                    loadUsers();
                    alert('Status activ actualizat cu succes!');
                } else if (data) {
                    alert('Eroare: ' + (data.message || 'Operație eșuată'));
                }
            })
            .catch(error => {
                console.error('Eroare:', error);
                alert('Eroare la actualizare!');
            });
    }

    function showUserDetails(userId, event) {
        event.preventDefault();

        fetch(`/Admin/UserDetails?userId=${userId}`)
            .then(response => response.json())
            .then(user => {
                const createdDate = new Date(user.createdUtc).toLocaleString('ro-RO');
                const updatedDate = new Date(user.updatedUtc).toLocaleString('ro-RO');

                const message = `
📊 DETALII UTILIZATOR
━━━━━━━━━━━━━━━━━━━━━━━━━━━━
📧 Email: ${user.email}
🔑 ID: ${user.id}
👤 Status Admin: ${user.isAdmin ? '✓ DA' : '✗ NU'}
✅ Status Activ: ${user.isActive ? '✓ DA' : '✗ NU'}
🔐 Parole salvate: ${user.passwordCount}
📝 Note salvate: ${user.noteCount}
📅 Creat la: ${createdDate}
🔄 Actualizat la: ${updatedDate}
                `;

                alert(message);
            })
            .catch(error => {
                console.error('Eroare:', error);
                alert('Eroare la preluarea detaliilor!');
            });
    }

    function resetUserPassword(userId, email, event) {
        event.preventDefault();

        if (!confirm(`Sigur resetezi parola pentru ${email}?\n\nVa primi o parolă temporară nouă.`)) 
            return;

        fetch(`/Admin/ResetPassword?userId=${userId}`, { method: 'POST' })
            .then(response => {
                if (response.status === 403) {
                    alert('Nu ai permisiuni!');
                    return null;
                }
                return response.json();
            })
            .then(data => {
                if (data && data.success) {
                    // Salvează datele pentru modalul de trimitere email
                    currentResetData = data;
                    currentUserId = userId;

                    // Afișează conținutul în modal
                    const content = `
                        <div class="alert alert-success">
                            <strong>✅ Parolă resetată cu succes!</strong>
                        </div>

                        <div class="mb-3">
                            <label class="form-label"><strong>📧 Pentru utilizatorul:</strong></label>
                            <div class="form-control-plaintext"><strong>${data.email}</strong></div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label"><strong>🔑 Parolă temporară:</strong></label>
                            <div class="input-group">
                                <input type="text" class="form-control" id="tempPassword" value="${data.temporaryPassword}" readonly>
                                <button class="btn btn-outline-secondary" type="button" onclick="copyToClipboard('tempPassword')">
                                    📋 Copiază
                                </button>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label"><strong>✉️ Trimite la emailul:</strong></label>
                            <input type="email" class="form-control" id="recipientEmail" value="${data.email}" placeholder="Email destinație">
                            <small class="text-muted">Poți modifica email-ul dacă vrei să o trimiți în alt loc</small>
                        </div>

                        <div class="alert alert-warning">
                            <strong>⚠️ ATENȚIE:</strong>
                            <ul class="mb-0 mt-2">
                                <li>Parola temporară a fost generată</li>
                                <li>Utilizatorul trebuie să se autentifice și să schimbe parola la prima logare</li>
                                <li>Apasă "✉️ Trimite Email" pentru a trimite parola utilizatorului</li>
                                <li>Nu o stoca în locuri nesecurizate</li>
                            </ul>
                        </div>
                    `;

                    document.getElementById('resetContent').innerHTML = content;

                    // Afișează modalul
                    const modal = new bootstrap.Modal(document.getElementById('resetPasswordModal'));
                    modal.show();

                    // Setează handler pentru buton Trimite Email
                    document.getElementById('btnSendEmail').onclick = function() {
                        sendPasswordResetEmail();
                    };

                } else if (data) {
                    alert('Eroare: ' + (data.message || 'Operație eșuată'));
                }
            })
            .catch(error => {
                console.error('Eroare:', error);
                alert('Eroare la resetarea parolei!');
            });
    }

    // Copiază parola în clipboard
    function copyToClipboard(elementId) {
        const element = document.getElementById(elementId);
        element.select();
        document.execCommand('copy');

        // Schimbă textul butonului temporar
        const btn = event.target;
        const originalText = btn.textContent;
        btn.textContent = '✓ Copiat!';
        setTimeout(() => {
            btn.textContent = originalText;
        }, 2000);
    }

    // Trimite parola prin email
    function sendPasswordResetEmail() {
        const recipientEmail = document.getElementById('recipientEmail').value;

        if (!recipientEmail) {
            alert('Introduceți o adresă de email validă');
            return;
        }

        // Dezactivează butonul în timp ce trimite
        const btn = document.getElementById('btnSendEmail');
        const originalText = btn.textContent;
        btn.disabled = true;
        btn.textContent = '⏳ Se trimite...';

        fetch('/Admin/SendPasswordResetEmail', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({
                userId: currentUserId,
                temporaryPassword: currentResetData.temporaryPassword,
                recipientEmail: recipientEmail
            })
        })
        .then(response => {
            if (response.status === 403) {
                alert('Nu ai permisiuni!');
                return null;
            }
            return response.json();
        })
        .then(data => {
            btn.disabled = false;
            btn.textContent = originalText;

            if (data && data.success) {
                alert('✅ Email trimis cu succes la: ' + recipientEmail);

                // Închide modalul
                const modal = bootstrap.Modal.getInstance(document.getElementById('resetPasswordModal'));
                if (modal) modal.hide();

                // Reîncarcă utilizatorii
                loadUsers();
            } else if (data) {
                alert('Eroare: ' + (data.message || 'Operație eșuată'));
            }
        })
        .catch(error => {
            console.error('Eroare:', error);
            btn.disabled = false;
            btn.textContent = originalText;
            alert('Eroare la trimiterea emailului!');
        });
    }

    // ========================================
    // DELETE USER FUNCTIONS
    // ========================================
    let deleteModalData = null;

    function deleteUser(userId, userEmail, event) {
        event.preventDefault();

        deleteModalData = { userId, userEmail };
        document.getElementById('deleteUserEmail').textContent = userEmail;

        const modal = new bootstrap.Modal(document.getElementById('deleteUserModal'));
        modal.show();
    }

    document.getElementById('btnConfirmDelete').addEventListener('click', function() {
        if (!deleteModalData) return;

        const { userId, userEmail } = deleteModalData;

        // Dezactivează butonul
        const btn = this;
        const originalText = btn.textContent;
        btn.disabled = true;
        btn.textContent = '⏳ Se șterge...';

        fetch(`/Admin/DeleteUser?userId=${userId}`, { method: 'POST' })
            .then(response => {
                if (response.status === 403) {
                    alert('Nu ai permisiuni!');
                    btn.disabled = false;
                    btn.textContent = originalText;
                    return null;
                }
                return response.json();
            })
            .then(data => {
                btn.disabled = false;
                btn.textContent = originalText;

                if (data && data.success) {
                    // Închide modal
                    const modal = bootstrap.Modal.getInstance(document.getElementById('deleteUserModal'));
                    if (modal) modal.hide();

                    // Reîncarcă utilizatori
                    loadUsers();

                    alert(`✅ Utilizator ${userEmail} șters cu succes!`);
                } else if (data) {
                    alert('Eroare: ' + (data.message || 'Operație eșuată'));
                }
            })
            .catch(error => {
                console.error('Eroare:', error);
                btn.disabled = false;
                btn.textContent = originalText;
                alert('Eroare la ștergere!');
            });

        deleteModalData = null;
    });

    // ========================================
    // LOAD DELETED USERS
    // ========================================
    function loadDeletedUsers() {
        fetch('/Admin/GetUsers?includeDeleted=true')
            .then(response => response.json())
            .then(data => {
                deletedUsersData = data.filter(u => u.isDeleted);
                renderDeletedUsers();
            })
            .catch(error => console.error('Eroare:', error));
    }

    function renderDeletedUsers() {
        const tbody = document.querySelector('#deletedUsersTable tbody');
        tbody.innerHTML = '';

        if (deletedUsersData.length === 0) {
            tbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted">Nu sunt utilizatori șterși</td></tr>';
            return;
        }

        sortDeletedUsersData(deletedUsersData).forEach(user => {
                    const row = document.createElement('tr');
                    const deletedDate = new Date(user.deletedUtc).toLocaleString('ro-RO');

                    row.innerHTML = `
                        <td>${user.id}</td>
                        <td>${user.email}</td>
                        <td>${deletedDate}</td>
                        <td>${user.deletedBy || 'Necunoscut'}</td>
                        <td>
                            <button class="btn btn-sm btn-outline-success" 
                                    onclick="restoreUser(${user.id}, '${user.email}', event)"
                                    title="Restaurează utilizatorul">
                                🔄 Restaurează
                            </button>
                        </td>
                    `;
                    tbody.appendChild(row);
        });
    }

    function sortDeletedUsers(key) {
        deletedUsersSort = {
            key: key,
            dir: deletedUsersSort.key === key && deletedUsersSort.dir === 'asc' ? 'desc' : 'asc'
        };
        renderDeletedUsers();
    }

    function sortDeletedUsersData(users) {
        if (!deletedUsersSort.key) return users;

        const factor = deletedUsersSort.dir === 'asc' ? 1 : -1;
        return [...users].sort((a, b) => {
            const va = getDeletedUserSortValue(a, deletedUsersSort.key);
            const vb = getDeletedUserSortValue(b, deletedUsersSort.key);
            const cmp = typeof va === 'number' ? va - vb : va.localeCompare(vb, 'ro');
            return cmp * factor;
        });
    }

    function getDeletedUserSortValue(user, key) {
        if (key === 'deletedUtc') return new Date(user.deletedUtc).getTime();
        if (key === 'deletedBy') return user.deletedBy || 'Necunoscut';
        return user.email;
    }

    // ========================================
    // RESTORE USER FUNCTIONS
    // ========================================
    let restoreModalData = null;

    function restoreUser(userId, userEmail, event) {
        event.preventDefault();

        restoreModalData = { userId, userEmail };
        document.getElementById('restoreUserEmail').textContent = userEmail;

        const modal = new bootstrap.Modal(document.getElementById('restoreUserModal'));
        modal.show();
    }

    document.getElementById('btnConfirmRestore').addEventListener('click', function() {
        if (!restoreModalData) return;

        const { userId, userEmail } = restoreModalData;

        // Dezactivează butonul
        const btn = this;
        const originalText = btn.textContent;
        btn.disabled = true;
        btn.textContent = '⏳ Se restaurează...';

        fetch(`/Admin/RestoreUser?userId=${userId}`, { method: 'POST' })
            .then(response => {
                if (response.status === 403) {
                    alert('Nu ai permisiuni!');
                    btn.disabled = false;
                    btn.textContent = originalText;
                    return null;
                }
                return response.json();
            })
            .then(data => {
                btn.disabled = false;
                btn.textContent = originalText;

                if (data && data.success) {
                    // Închide modal
                    const modal = bootstrap.Modal.getInstance(document.getElementById('restoreUserModal'));
                    if (modal) modal.hide();

                    // Reîncarcă amândoi tabelele
                    loadUsers();
                    loadDeletedUsers();

                    alert(`✅ Utilizator ${userEmail} restaurat cu succes!`);
                } else if (data) {
                    alert('Eroare: ' + (data.message || 'Operație eșuată'));
                }
            })
            .catch(error => {
                console.error('Eroare:', error);
                btn.disabled = false;
                btn.textContent = originalText;
                alert('Eroare la restaurare!');
            });

        restoreModalData = null;
    });
</script>
