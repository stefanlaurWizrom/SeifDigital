@model List<SeifDigital.Models.UserNote>

@{
    ViewData["Title"] = "Note";

    string q = (string)(ViewBag.Q ?? "");
    int pageNo = (int)(ViewBag.Page ?? 1);
    int pageSize = (int)(ViewBag.PageSize ?? 25);
    int total = (int)(ViewBag.Total ?? 0);

    int totalPages = (int)Math.Ceiling(total / (double)pageSize);
    if (totalPages < 1) totalPages = 1;

    if (pageNo < 1) pageNo = 1;
    if (pageNo > totalPages) pageNo = totalPages;
}

<div class="container mt-4" style="max-width:1100px;">
    @Html.AntiForgeryToken()

    <h2>Note</h2>
    <p class="text-muted">Note personale (Titlu + Conținut, max 255 caractere fiecare). Vizibile doar ție.</p>

    <!-- Add note -->
    <form asp-action="Add" method="post" class="mb-4">
        @Html.AntiForgeryToken()

        <div class="row g-2">
            <div class="col-12">
                <input name="title"
                       class="form-control"
                       maxlength="255"
                       placeholder="Titlu (ex: VPN Prod, Acces server, Idee)..." />
                <small class="text-muted">Maxim 255 caractere.</small>
            </div>

            <div class="col-12">
                <textarea name="text"
                          class="form-control"
                          rows="3"
                          maxlength="255"
                          placeholder="Conținut (max 255)..."></textarea>
                <small class="text-muted">Maxim 255 caractere.</small>
            </div>
        </div>

        <button class="btn btn-primary mt-2" type="submit">Salvează nota</button>
    </form>

    <hr />

    <!-- Header + Total (ca la Parole) -->
    <div class="d-flex justify-content-between align-items-end">
        <div>
            <h4 class="mb-0">Note salvate</h4>
            <div class="text-muted small mt-1">
                @if (!string.IsNullOrWhiteSpace(q))
                {
                    <span>Rezultate pentru: <b>@q</b> • </span>
                }
                <span>Total: <b>@total</b></span>
            </div>
        </div>
    </div>

    <!-- Search (mutat sub "Note salvate", ca la Parole) -->
    <form method="get" class="row g-2 mt-3 mb-3">
        <div class="col-md-8">
            <input class="form-control"
                   name="q"
                   value="@q"
                   placeholder="Caută în titlu sau text..." />
        </div>
        <div class="col-md-2">
            <button class="btn btn-outline-primary w-100" type="submit">Caută</button>
        </div>
        <div class="col-md-2">
            <a class="btn btn-outline-secondary w-100" href="/Notes">Reset</a>
        </div>
    </form>

    <div class="mt-3">
        @if (Model == null || Model.Count == 0)
        {
            <p class="text-muted fst-italic">Nu ai note salvate.</p>
        }
        else
        {
            <div class="list-group">
                @foreach (var n in Model)
                {
                    <div class="list-group-item d-flex justify-content-between align-items-start">
                        <div class="me-3" style="min-width:0;">
                            <div class="fw-semibold text-truncate">@n.Title</div>
                            <div class="mt-1" style="white-space:pre-wrap">@n.Text</div>
                        </div>

                        <div class="text-end" style="min-width:220px;">
                            <div class="text-muted small">@n.UpdatedUtc.ToString("yyyy-MM-dd HH:mm")</div>

                            <a class="btn btn-sm btn-outline-secondary mt-2 w-100"
                               href="/Notes/Edit/@n.Id">
                                Edit
                            </a>

                            <button type="button"
                                    class="btn btn-sm btn-outline-warning mt-2 w-100"
                                    onclick="openImageModal(@n.Id)">
                                📁 Fisiere
                            </button>

                            <button type="button"
                                    class="btn btn-sm btn-outline-primary mt-2 w-100"
                                    onclick="openSendNoteModal(@n.Id)">
                                Trimite
                            </button>

                            <form asp-action="Delete" method="post" class="mt-2">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@n.Id" />
                                <button class="btn btn-sm btn-outline-danger w-100" type="submit">Șterge</button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Pagination -->
    @{
        var prevDisabled = pageNo <= 1;
        var nextDisabled = pageNo >= totalPages;

        var qEsc = Uri.EscapeDataString(q ?? "");
        var prevPage = pageNo - 1;
        var nextPage = pageNo + 1;

        var prevHref = prevDisabled ? "#" : $"/Notes?q={qEsc}&page={prevPage}";
        var nextHref = nextDisabled ? "#" : $"/Notes?q={qEsc}&page={nextPage}";
    }

    <div class="d-flex justify-content-between align-items-center mt-3">
        <div class="text-muted small">
            Pagina <b>@pageNo</b> din <b>@totalPages</b>
        </div>

        <div class="btn-group">
            <a class="btn btn-outline-secondary @(prevDisabled ? "disabled" : "")"
               href="@prevHref"
               tabindex="@(prevDisabled ? "-1" : "0")"
               aria-disabled="@(prevDisabled ? "true" : "false")">
                ‹ Prev
            </a>

            <a class="btn btn-outline-secondary @(nextDisabled ? "disabled" : "")"
               href="@nextHref"
               tabindex="@(nextDisabled ? "-1" : "0")"
               aria-disabled="@(nextDisabled ? "true" : "false")">
                Next ›
            </a>
        </div>
    </div>
</div>

<!-- Modal: Trimite notă -->
<div class="modal fade" id="sendNoteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-controller="Notes" asp-action="Send" method="post" class="mb-0">
                @Html.AntiForgeryToken()

                <div class="modal-header">
                    <h5 class="modal-title">Trimite nota</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <input type="hidden" name="id" id="sendNoteId" value="" />

                    <label class="form-label">Email destinatar</label>
                    <input type="text"
                           class="form-control"
                           name="recipientEmail"
                           id="sendNoteRecipientEmail"
                           placeholder="ex: coleg@wizrom.ro"
                           required />
                    <div class="form-text">Introdu emailul utilizatorului din WizVault.</div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Renunță</button>
                    <button type="submit" class="btn btn-primary">Trimite</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ✅ Modal pentru fișiere Note - IDENTIC CU PAROLE -->
<div class="modal fade" id="imageModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="imageUploadId" value="" />
            <input type="hidden" name="fileType" id="fileType" value="image" />

            <div class="modal-header">
                <h5 class="modal-title">📁 Fișiere pentru notă</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <!-- Fișiere existente -->
                <div id="imagePreviewContainer" class="mb-4">
                    <!-- Se populează din JS -->
                </div>

                <!-- Upload fișier - CU BUTON SEPARAT -->
                <div class="card">
                    <div class="card-header bg-light">
                        <h6 class="mb-0">📤 Adauga fișiere noi</h6>
                    </div>
                    <div class="card-body">
                        <label for="imageFileInput" class="form-label">Selectează fișier</label>
                        <div class="input-group mb-2">
                            <input type="file" 
                                   id="imageFileInput" 
                                   accept=".jpg,.jpeg,.png,.gif,.webp,.txt,.doc,.docx,.pdf,.xlsx,.xls,.cer,.pfx,.pem,.crt,.key" 
                                   class="form-control" />
                            <button type="button" class="btn btn-outline-primary" id="btnUploadFile">
                                ⬆️ Incarcă
                            </button>
                        </div>
                        <small class="text-muted" id="fileCategoriesText">
                            📸 Imagini (JPG, PNG, GIF, WEBP) - Max 5MB | 
                            📄 Documente (TXT, DOC, DOCX, PDF, XLSX) - Max 10MB | 
                            🔐 Certificate (CER, PFX, PEM, CRT, KEY) - Max 2MB
                        </small>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Inchide</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // 🔄 VARIABILĂ GLOBALĂ: Hartă dinamică extensie → categorie (EXACT CA PAROLE)
        let extensionToCategoryMap = {};
        let currentNoteId = null;

        // ✅ ÎNCARCĂ CATEGORIILE PE PAGE LOAD (similar Parole)
        (async function loadFileCategoriesOnPageLoad() {
            try {
                // 1. Citește HTML-ul pentru afișare
                const htmlResponse = await fetch("/Notes/GetFileCategoriesHtml");
                if (!htmlResponse.ok) {
                    console.warn("⚠️ GetFileCategoriesHtml returned:", htmlResponse.status);
                    return;
                }

                const htmlData = await htmlResponse.json();
                if (htmlData && htmlData.html) {
                    // Nu actualizez HTML pe load, doar la deschiderea modal-ului
                }

                // 2. ✅ Citește structura JSON pentru logică frontend
                const jsonResponse = await fetch("/Notes/GetFileCategoriesJson");
                if (!jsonResponse.ok) {
                    console.warn("⚠️ GetFileCategoriesJson returned:", jsonResponse.status);
                    return;
                }

                const jsonData = await jsonResponse.json();

                if (jsonData.categories && Array.isArray(jsonData.categories)) {
                    // Construiește hartă: extensie → categorie (EXACT CA PAROLE)
                    extensionToCategoryMap = {};
                    jsonData.categories.forEach(cat => {
                        if (cat.extensions && Array.isArray(cat.extensions)) {
                            cat.extensions.forEach(ext => {
                                extensionToCategoryMap[ext] = cat.name;
                            });
                        }
                    });

                    console.log("✅ [FileCategories] Extension map loaded:", extensionToCategoryMap);
                } else {
                    console.warn("⚠️ [FileCategories] No categories in response");
                }
            } catch (error) {
                console.error("❌ Error loading file categories on page load:", error);
            }
        })();

        // ✅ DESCHIDERE MODAL - EXACT CA PAROLE
        function openImageModal(noteId) {
            currentNoteId = noteId;
            document.getElementById('imageUploadId').value = noteId;

            const container = document.getElementById('imagePreviewContainer');
            container.innerHTML = '<p class="text-muted">Se încarcă fișierele...</p>';

            // Preia fișierele pentru această notă
            fetch(`/Notes/GetNoteImages?id=${noteId}`)
                .then(r => {
                    if (!r.ok) throw new Error(`HTTP ${r.status}`);
                    return r.json();
                })
                .then(data => {
                    container.innerHTML = '';

                    if (!data.success || !data.images || data.images.length === 0) {
                        container.innerHTML = '<p class="text-muted">Nicio fișier ataşat</p>';
                    } else {
                        // Crează galerie similar cu Parole
                        const iconMap = {
                            'image': '📸',
                            'document': '📄',
                            'certificate': '🔐'
                        };

                        let html = `<div class="card mb-4">
                            <div class="card-header bg-info bg-opacity-10">
                                <h6 class="mb-0">${iconMap[data.images[0].fileType] || '📁'} Fișiere atasate (${data.images.length})</h6>
                            </div>
                            <div class="card-body">
                                <div class="list-group">`;

                        data.images.forEach(img => {
                            const icon = iconMap[img.fileType] || '📁';
                            html += `
                                <div class="list-group-item d-flex justify-content-between align-items-center">
                                    <div class="flex-grow-1">
                                        <div><strong>${icon} ${img.fileName}</strong></div>
                                        <small class="text-muted">${(img.sizeBytes / 1024).toFixed(0)} KB</small>
                                    </div>
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a href="/Notes/DownloadImage?fileId=${img.id}" class="btn btn-outline-primary" download>⬇️</a>
                                        <button type="button" class="btn btn-outline-danger" onclick="deleteImage(${noteId}, ${img.id})">🗑️</button>
                                    </div>
                                </div>
                            `;
                        });

                        html += '</div></div></div>';
                        container.innerHTML = html;
                    }
                })
                .catch(err => {
                    console.error("❌ Error loading files:", err);
                    container.innerHTML = '<p class="text-danger">Eroare la încărcarea fișierelor</p>';
                });

            // Încarcă categoriile text pentru afișare
            fetch("/Notes/GetFileCategoriesHtml")
                .then(r => r.json())
                .then(data => {
                    if (data && data.html) {
                        document.getElementById("fileCategoriesText").innerHTML = data.html;
                    }
                })
                .catch(err => console.warn("⚠️ Could not load categories HTML"));

            const modal = new bootstrap.Modal(document.getElementById('imageModal'));
            modal.show();
        }

        // ✅ ȘTERGE FIȘIER - EXACT CA PAROLE
        async function deleteImage(noteId, fileId) {
            if (!confirm('Sigur vrei să ștergi acest fișier?')) return;

            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            const token = tokenInput ? tokenInput.value : '';

            try {
                const response = await fetch('/Notes/DeleteImage', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8'
                    },
                    body: `noteId=${encodeURIComponent(noteId)}&fileId=${encodeURIComponent(fileId)}&__RequestVerificationToken=${encodeURIComponent(token)}`
                });

                if (response.ok) {
                    const result = await response.json();
                    if (result.success) {
                        alert('✅ Fișier șters cu succes!');
                        // ✅ INCHIDE modalul complet și curață backdrop-ul (EXACT CA PAROLE)
                        const modal = bootstrap.Modal.getInstance(document.getElementById('imageModal'));
                        if (modal) {
                            modal.hide();
                        }
                        document.querySelectorAll('.modal-backdrop').forEach(el => el.remove());
                        document.body.classList.remove('modal-open');
                        document.body.style.overflow = '';
                        // Reîncarcă pagina
                        location.reload();
                    } else {
                        alert('❌ ' + (result.message || 'Eroare la ștergerea fișierului'));
                    }
                } else {
                    alert('❌ Eroare server la ștergere.');
                }
            } catch (e) {
                console.error(e);
                alert('❌ Eroare de rețea.');
            }
        }

        // ✅ DETECTARE FILETYPE SAU PREVIEW - EXACT CA PAROLE
        document.getElementById("imageFileInput")?.addEventListener("change", function() {
            const file = this.files[0];
            const previewContainer = document.getElementById("imagePreviewContainer");

            previewContainer.innerHTML = "";

            if (file) {
                // ✅ STRICT: Extrage extensia
                const ext = ("." + file.name.toLowerCase().split('.').pop()).toLowerCase();

                // ✅ DINAMIC: Citește din hartă globală
                let fileType = extensionToCategoryMap[ext];

                console.log(`📁 File: ${file.name}, Extension: ${ext}, Detected Category: ${fileType || "UNKNOWN"}`);

                // ✅ Setează hidden fileType
                document.getElementById("fileType").value = fileType || "";

                // Preview pentru imagini
                if (fileType === "image") {
                    const reader = new FileReader();

                    reader.onload = function(e) {
                        const img = document.createElement("img");
                        img.src = e.target.result;
                        img.classList.add("img-fluid");
                        img.style.maxHeight = "400px";
                        img.style.objectFit = "contain";
                        previewContainer.appendChild(img);
                    };

                    reader.readAsDataURL(file);
                } else if (fileType) {
                    // Pentru alte tipuri cunoscute, afișează info
                    const info = document.createElement("div");
                    info.className = "alert alert-info";
                    info.innerHTML = `
                        <strong>📄 ${fileType.toUpperCase()}</strong><br>
                        Fișier: ${file.name}<br>
                        Mărime: ${(file.size / 1024).toFixed(2)} KB
                    `;
                    previewContainer.appendChild(info);
                } else {
                    // Fișier necunoscut
                    const info = document.createElement("div");
                    info.className = "alert alert-warning";
                    info.innerHTML = `
                        <strong>⚠️ Tip necunoscut</strong><br>
                        Fișier: ${file.name}<br>
                        Extensie: ${ext}<br>
                        <small>Această extensie nu se regasește în lista categoriilor permise.</small>
                    `;
                    previewContainer.appendChild(info);
                }
            }
        });

        // ✅ UPLOAD VIA AJAX - EXACT CA PAROLE (fără validare form)
        document.getElementById("btnUploadFile")?.addEventListener("click", async function() {
            const file = document.getElementById("imageFileInput")?.files[0];
            const id = document.getElementById("imageUploadId").value;

            if (!file) {
                alert("Te rog selectează un fișier înainte de a încarca.");
                return;
            }

            if (!id) {
                alert("ID notă lipsă.");
                return;
            }

            // ✅ EXTRACT EXTENSION (nu categoria!) - EXACT CA PAROLE
            const fileName = file.name.toLowerCase();
            const extension = "." + fileName.split('.').pop();

            // Crează FormData
            const formData = new FormData();
            formData.append("id", id);
            formData.append("imageFile", file);
            formData.append("fileExtension", extension);  // ✅ Trimite EXTENSION, NU fileType

            // Preluă token CSRF
            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            if (tokenInput) {
                formData.append("__RequestVerificationToken", tokenInput.value);
            }

            try {
                const response = await fetch("/Notes/UploadImage", {
                    method: "POST",
                    body: formData
                });

                if (!response.ok) {
                    alert(`❌ Eroare server: ${response.status}`);
                    return;
                }

                // ✅ Parsează JSON response
                const result = await response.json();

                if (result.ok) {
                    alert(result.message);
                    // Curăță file input
                    document.getElementById("imageFileInput").value = "";
                    // ✅ INCHIDE modalul complet și curață backdrop-ul (EXACT CA PAROLE)
                    const modal = bootstrap.Modal.getInstance(document.getElementById('imageModal'));
                    if (modal) {
                        modal.hide();
                    }
                    document.querySelectorAll('.modal-backdrop').forEach(el => el.remove());
                    document.body.classList.remove('modal-open');
                    document.body.style.overflow = '';
                    // ✅ Reîncarcă pagina pentru a vedea fișierul nou (EXACT CA PAROLE)
                    location.reload();
                } else {
                    // ✅ Afișează mesajul de eroare EXACT cum vine de la backend
                    alert(result.message || "❌ Upload eșuat din motiv necunoscut");
                }
            } catch (err) {
                console.error(err);
                alert("❌ Eroare de rețea la upload.");
            }
        });

        function openSendNoteModal(id) {
            const hiddenId = document.getElementById("sendNoteId");
            const emailInput = document.getElementById("sendNoteRecipientEmail");

            if (hiddenId) hiddenId.value = id;
            if (emailInput) {
                emailInput.value = "";
                setTimeout(() => emailInput.focus(), 150);
            }

            const modalEl = document.getElementById("sendNoteModal");
            const modal = new bootstrap.Modal(modalEl);
            modal.show();
        }
    </script>
}
