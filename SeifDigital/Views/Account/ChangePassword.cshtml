@{
    ViewData["Title"] = "Schimbă Parola";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">🔐 Schimbă Parola</h4>
                </div>

                <div class="card-body">
                    @if (!string.IsNullOrEmpty(ViewBag.Mesaj))
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @ViewBag.Mesaj
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form method="post" asp-action="ChangePassword">
                        <input type="hidden" name="__RequestVerificationToken" value="@ViewContext.HttpContext.Session.GetString("__RequestVerificationToken")" />

                        <div class="mb-3">
                            <label for="oldPassword" class="form-label">
                                <strong>Parola Actuală:</strong>
                            </label>
                            <input type="password" 
                                   class="form-control" 
                                   id="oldPassword" 
                                   name="oldPassword" 
                                   required 
                                   placeholder="Introduceți parola actuală">
                            <small class="text-muted d-block mt-1">
                                Trebuie să introduceți parola actuală pentru a o confirma
                            </small>
                        </div>

                        <hr>

                        <div class="mb-3">
                            <label for="newPassword" class="form-label">
                                <strong>Noua Parolă:</strong>
                            </label>
                            <input type="password" 
                                   class="form-control" 
                                   id="newPassword" 
                                   name="newPassword" 
                                   required 
                                   placeholder="Introduceți noua parolă">
                            <small class="text-muted d-block mt-1">
                                Minim 12 caractere cu majuscule, minuscule, cifre și simboluri
                            </small>
                        </div>

                        <div class="mb-3">
                            <label for="confirmPassword" class="form-label">
                                <strong>Confirmă Noua Parolă:</strong>
                            </label>
                            <input type="password" 
                                   class="form-control" 
                                   id="confirmPassword" 
                                   name="confirmPassword" 
                                   required 
                                   placeholder="Confirmați noua parolă">
                        </div>

                        <div class="mb-3">
                            <div class="alert alert-info">
                                <strong>⚠️ Cerințe pentru parolă:</strong>
                                <ul class="mb-0 mt-2">
                                    <li>Minim 12 caractere</li>
                                    <li>Conține majuscule (A-Z)</li>
                                    <li>Conține minuscule (a-z)</li>
                                    <li>Conține cifre (0-9)</li>
                                    <li>Conține simboluri (! @@ # $ % ^ &amp; *)</li>
                                </ul>
                            </div>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-between">
                            <a href="@Url.Action("Index", "Home")" class="btn btn-secondary">
                                ← Înapoi
                            </a>
                            <button type="submit" class="btn btn-primary">
                                ✓ Schimbă Parolă
                            </button>
                        </div>
                    </form>
                </div>

                <div class="card-footer text-muted text-center">
                    <small>Parola va fi criptată și stocată în siguranță</small>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Show success message if exists
    document.addEventListener('DOMContentLoaded', function() {
        const form = document.querySelector('form');
        if (form) {
            form.addEventListener('submit', function(e) {
                const oldPassword = document.getElementById('oldPassword').value;
                const newPassword = document.getElementById('newPassword').value;
                const confirmPassword = document.getElementById('confirmPassword').value;

                if (!oldPassword || !newPassword || !confirmPassword) {
                    e.preventDefault();
                    alert('Toate câmpurile sunt obligatorii!');
                    return false;
                }

                if (newPassword !== confirmPassword) {
                    e.preventDefault();
                    alert('Parolele noi nu se potrivesc!');
                    return false;
                }

                if (newPassword.length < 12) {
                    e.preventDefault();
                    alert('Parola trebuie să aibă minim 12 caractere!');
                    return false;
                }
            });
        }
    });
</script>
